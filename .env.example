# ---------------------------------------------------------------------------
# The only thing you have to fill in. Copy this file to .env
#
#   cp .env.example .env
#
# Primary brain: DeepSeek Flash, which is OpenAI-compatible and paid.
#   key: https://platform.deepseek.com/api_keys
#
# Free backups, tried in this order after the primary: Gemini, Groq,
# OpenRouter's free-models router. Add any or all of them; one is enough.
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/settings/keys
# A provider that returns 429/quota is skipped for 20 minutes, then retried.
#
# With no key at all, he keeps living on reflexes.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides for the free chain:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=openrouter/free
#
# Optional: use any OpenAI-compatible endpoint as the primary instead.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_VISION_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Optional: change the port he lives on (default 4321)
# PORT=4321

# Optional: let him talk to you on Discord.
#   1. https://discord.com/developers/applications -> New Application -> Bot
#   2. copy the token, and switch ON "Message Content Intent" under Bot
#   3. invite it with the bot scope + Send Messages / Read Message History
#   4. in Discord: User Settings -> Advanced -> Developer Mode, right-click the
#      channel, Copy Channel ID
# Without these two values the bridge stays off and nothing changes.
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# Set to 0 if you would rather he did not post his diary there.
# DISCORD_ANNOUNCE_DIARIES=1
