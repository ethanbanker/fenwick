# ---------------------------------------------------------------------------
# The only thing you have to fill in. Copy this file to .env
#
#   cp .env.example .env
#
# Primary brain: DeepSeek Flash, which is OpenAI-compatible.
#   key: https://platform.deepseek.com/api_keys
# Backup brain: Gemini, used automatically when DeepSeek fails, has no key,
# or a picture needs looking at. Google AI Studio has a free tier.
#   key: https://aistudio.google.com/apikey
#
# One key is enough to live. With neither, he keeps living on reflexes.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional: use any OpenAI-compatible endpoint instead (Groq, Cerebras,
# OpenRouter, a local Ollama, ...). Also put the model names in config.json.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_VISION_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Optional: change the port he lives on (default 4321)
# PORT=4321

# Optional: let him talk to you on Discord.
#   1. https://discord.com/developers/applications -> New Application -> Bot
#   2. copy the token, and switch ON "Message Content Intent" under Bot
#   3. invite it with the bot scope + Send Messages / Read Message History
#   4. in Discord: User Settings -> Advanced -> Developer Mode, right-click the
#      channel, Copy Channel ID
# Without these two values the bridge stays off and nothing changes.
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# Set to 0 if you would rather he did not post his diary there.
# DISCORD_ANNOUNCE_DIARIES=1
